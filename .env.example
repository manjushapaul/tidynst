# Copy to .env.local for local development. Never commit real values.

# PostgreSQL connection for this project's own database. The app refuses any database name other
# than tidynest_cms_dev / tidynest_cms_qa locally, and tidynest_cms_prod only in Vercel production.
# Remote (Neon) URLs must include sslmode=require.
DATABASE_URL=

# Public origin used for canonical URLs, the sitemap and structured data (https in production).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional public contact email shown on /contact.
NEXT_PUBLIC_CONTACT_EMAIL=

# Search-engine indexing. Leave unset until the owner approves launch; then set to "enabled"
# in the production environment only.
SITE_INDEXING=

# Google Search Console HTML-tag verification token (optional; DNS verification is preferred).
GOOGLE_SITE_VERIFICATION=

# Google Analytics: disabled unless BOTH are set, after owner approval.
NEXT_PUBLIC_ANALYTICS_ENABLED=
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Affiliate monetisation: disabled unless the owner explicitly approves it.
AFFILIATE_LINKS_ENABLED=
