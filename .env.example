# Copy to .env.local for local development. Never commit real values.

# PostgreSQL connection for this project's own database. The app refuses any database name other
# than tidynest_cms_dev / tidynest_cms_qa locally, and tidynest_cms_prod only in Vercel production.
# Remote (Neon) URLs must include sslmode=require.
DATABASE_URL=

# Public origin used for canonical URLs, the sitemap and structured data (https in production).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Address that receives the public contact form. Also shown on /contact when set.
NEXT_PUBLIC_CONTACT_EMAIL=

# Search-engine indexing. Leave unset until the owner approves launch; then set to "enabled"
# in the production environment only.
SITE_INDEXING=

# Google Search Console HTML-tag verification token (optional; DNS verification is preferred).
GOOGLE_SITE_VERIFICATION=

# Google Analytics: disabled unless BOTH are set, after owner approval.
NEXT_PUBLIC_ANALYTICS_ENABLED=
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Affiliate monetisation: disabled unless the owner explicitly approves it.
AFFILIATE_LINKS_ENABLED=

# Vercel Blob read-write token for CMS image storage (private store). Server-only — never expose
# to the browser. Create a private Blob store in the Vercel project, then paste the token here
# for local/QA. On Vercel production the project link may supply credentials via OIDC; the token
# is still required for local development and for non-Vercel runtimes. Without it, new uploads
# fall back to legacy Postgres bytea storage.
BLOB_READ_WRITE_TOKEN=

# Transactional email for admin password resets (Resend). Both are required for real delivery.
# Without them, non-production logs the message to the server console; production fails closed
# for delivery but still shows the generic “if that email belongs…” response.
RESEND_API_KEY=
EMAIL_FROM=

# Automation API for tools such as n8n (docs/N8N-AUTOMATION.md). Off unless BOTH are set.
# The key must be at least 32 characters (for example: openssl rand -base64 48). Requests act as
# the CMS user with this email; give it the Author role so it can create drafts but never publish.
AUTOMATION_API_KEY=
AUTOMATION_USER_EMAIL=
